# Dependencies
/node_modules

# Production
/build

# Generated files
.docusaurus
.cache-loader

# Generated API reference (populated by scripts/sync-*.mjs). README stays.
# Directories must be re-included at every depth or git won't descend
# into them — bitcore packages live at api/bitcore/<package>/README.md
# which is two levels below /api/.
/api/**
!/api/
!/api/**/
!/api/**/README.md

# Local deploy config — contains the Droplet origin IP; not for the repo.
/scripts/deploy.env

# Python venv — created via `python3 -m venv .venv`; contents are not for git.
/.venv

# Misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
